# Required: OpenRouter API key for the AI FAQ chat widget (server-side only).
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: comma-separated fallback chain of models, tried in order.
# Defaults to a curated set of five FREE models, each on a DIFFERENT provider
# pool (see src/lib/openrouter.ts). Every ":free" model has exactly one pool,
# and pools return 429 when saturated — typically only 1-2 of the five are up
# at any moment, which is why the chain exists.
# OpenRouter caps `models` at 3 per request, so the chain is sent as
# consecutive batches of 3 under one shared time budget.
OPENROUTER_MODELS=

# Optional: sets only the PRIMARY model; the default chain follows it.
OPENROUTER_MODEL=

# Optional: production site URL (e.g. the Vercel deployment URL), used to
# generate absolute Open Graph / canonical URLs.
NEXT_PUBLIC_SITE_URL=
