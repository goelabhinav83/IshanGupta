# Required: OpenRouter API key for the AI FAQ chat widget (server-side only).
OPENROUTER_API_KEY=

# Optional: OpenRouter model id to use. Defaults to anthropic/claude-haiku-4.5.
OPENROUTER_MODEL=

# Required: Gmail account used to send appointment-request form submissions
# to the doctor's email address (server-side only, via /api/contact).
GMAIL_USER=

# Required: a Gmail App Password for the account above (not the account's login
# password). Generate one at https://myaccount.google.com/apppasswords — requires
# 2-Step Verification to be enabled on that Google account.
GMAIL_APP_PASSWORD=

# Optional: production site URL (e.g. the Vercel deployment URL), used to
# generate absolute Open Graph / canonical URLs.
NEXT_PUBLIC_SITE_URL=
